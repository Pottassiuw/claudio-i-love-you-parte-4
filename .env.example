# Porta da API
PORT=3000

# Conexão com o MySQL (NÃO coloque senhas reais neste arquivo)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=treinos_esportivos
DB_USER=root
DB_PASSWORD=sua_senha_aqui

# true = mostra no console o SQL gerado pelo Sequelize
DB_LOGGING=false

# Ambiente (development | production)
NODE_ENV=development
